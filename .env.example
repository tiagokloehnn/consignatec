# GEMINI_API_KEY / CONSIGNATEC_GEMINI_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects GEMINI_API_KEY at runtime from user secrets.
# In Vercel, you can use CONSIGNATEC_GEMINI_KEY.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
CONSIGNATEC_GEMINI_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE (Opcional - para persistência na nuvem)
# Obtenha em: https://supabase.com -> Project Settings -> API
VITE_CONSIGNATEC_SUPABASE_URL="https://your-project.supabase.co"
VITE_CONSIGNATEC_SUPABASE_ANON_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
